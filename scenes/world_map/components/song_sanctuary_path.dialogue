~ start
if not musician_quest_unlocker.is_satisfied():
	Bridgette BeamBuckle: That bridge to the east has been broken for ages.
	Bridgette BeamBuckle: Have you met the musician? He lives north of here.
	% Bridgette BeamBuckle: Maybe you can help him put this place back together.
	% Bridgette BeamBuckle: I still can’t figure out how he plays that triple-necked guitar. He only has two hands!
	% Bridgette BeamBuckle: To be honest, I blame him for how run-down this place is. He stopped turning up for our weekly singalongs.
elif not guarded_stones_unlocker.is_satisfied() or not oops_all_inkdrinkers_unlocker.is_satisfied():
	if not guarded_stones_unlocker.is_satisfied() and not oops_all_inkdrinkers_unlocker.is_satisfied():
		# If the player has completed neither, thank them for the first quest
		Bridgette BeamBuckle: Thanks for helping clear away those InkDrinkers!
		Bridgette BeamBuckle: I fixed the bridge east of here while you were away.
	if not guarded_stones_unlocker.is_satisfied():
		Bridgette BeamBuckle: The musician found another set of stones and altars to the east, but they are guarded by StoryVores.
		Bridgette BeamBuckle: I think you could sneak past them and rediscover the melodies!
	else:
		Bridgette BeamBuckle: I'm afraid there's another infestation of InkDrinkers east of here.
		Bridgette BeamBuckle: Can you help clear them away?
else:
	Bridgette BeamBuckle: Thanks for all your help!
=> END
