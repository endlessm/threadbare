[node name="Sign" parent="OnTheGround/Signs" unique_id=160304446 instance=ExtResource("9_ctt8w")]
position = Vector2(453, 1307)
direction = 1
text = "Test out your range with the grapple.
It starts at 200 pixels by default, but the size of the HookableArea
makes each direction a little different."

[node name="Sign2" parent="OnTheGround/Signs" unique_id=1986010643 instance=ExtResource("9_ctt8w")]
position = Vector2(490, 618)
text = "Distances are based on the Player's global_position.
The pins on sand are one pixel out of reach!"

[node name="Sign3" parent="OnTheGround/Signs" unique_id=410453707 instance=ExtResource("9_ctt8w")]
position = Vector2(2633, 602)
direction = 1
text = "After getting the \"Longer Thread\" ability
your grapple range increases!
The default range becomes 400 pixels."

[node name="Sign4" parent="OnTheGround/Signs" unique_id=2010658683 instance=ExtResource("9_ctt8w")]
position = Vector2(925, -371)
text = "You can reach further with the needle
than the default grapple."

[node name="Sign5" parent="OnTheGround/Signs" unique_id=1579530966 instance=ExtResource("9_ctt8w")]
position = Vector2(674, -1114)
direction = 1
text = "Chaining a set of needles together can be used to trigger events."

