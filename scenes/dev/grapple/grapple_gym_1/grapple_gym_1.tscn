[node name="Sign" parent="OnTheGround/Signs" unique_id=1579530966 instance=ExtResource("8_m27j3")]
position = Vector2(3813, 16)
text = "Can you go back the way you came?
No?
Sometimes grappling is asymmetric!"

[node name="Sign2" parent="OnTheGround/Signs" unique_id=2081742116 instance=ExtResource("8_m27j3")]
position = Vector2(3812, 1291)
direction = 1
text = "Head to the next scene to experiment with
grapple's reach and the longer thread ability!"

[node name="Sign3" parent="OnTheGround/Signs" unique_id=1773352329 instance=ExtResource("8_m27j3")]
position = Vector2(2265, -90)
text = "Hookable objects must be positioned
at multiples of 45-degree angles.
Notice that the needle on the left is not
accessible for keyboard-only users."

[node name="Sign4" parent="OnTheGround/Signs" unique_id=436998371 instance=ExtResource("8_m27j3")]
position = Vector2(1242, 93)
direction = 1
text = "Needles can be used to chain
together a longer string."

[node name="Sign5" parent="OnTheGround/Signs" unique_id=580295205 instance=ExtResource("8_m27j3")]
position = Vector2(3572, 900)
text = "Step on the dirt to change the
color of your grapple string sprite!"

[node name="Sign6" parent="OnTheGround/Signs" unique_id=1243964100 instance=ExtResource("8_m27j3")]
position = Vector2(148, 410)
direction = 1
text = "Throw your grapple at hookable pins to get a boost!"

[node name="Sign7" parent="OnTheGround/Signs" unique_id=682424268 instance=ExtResource("8_m27j3")]
position = Vector2(689, 405)
direction = 1
text = "You can even propel yourself across gaps!"

