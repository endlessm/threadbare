[node name="Sign" parent="OnTheGround/Signs" unique_id=1956680058 instance=ExtResource("16_ff0o0")]
position = Vector2(345, 651)
direction = 1
text = "Sometimes you want to decorate a large area
without placing each scene by hand."

[node name="Sign2" parent="OnTheGround/Signs" unique_id=1009085323 instance=ExtResource("16_ff0o0")]
position = Vector2(587, 563)
direction = 1
text = "Threadbare includes a tool called AreaFiller,
which can automatically populate an Area2D or StaticBody2D's shapes
with scenes of your choosing."

[node name="Sign3" parent="OnTheGround/Signs" unique_id=1548001380 instance=ExtResource("16_ff0o0")]
position = Vector2(963, 371)
text = "Each interaction with this rock regenerates
 the field with a new selection
of flowers and mushrooms."

[node name="Sign4" parent="OnTheGround/Signs" unique_id=1285616961 instance=ExtResource("16_ff0o0")]
position = Vector2(1222, 624)
text = "Each part of this field is covered
by a CollisionPolygon2D shape,
which is a sibling of the AreaFiller node."

[node name="Sign6" parent="OnTheGround/Signs" unique_id=1579530966 instance=ExtResource("16_ff0o0")]
position = Vector2(799, -257)
text = "Decrease (left) or increase (right) the space
 between each object, then go back and redraw!"

[node name="Sign7" parent="OnTheGround/Signs" unique_id=613914873 instance=ExtResource("16_ff0o0")]
position = Vector2(1635, -284)
text = "The TreesPath Area2D is only used
to hold the trees. It is set to not
collide with anything."

[node name="Sign8" parent="OnTheGround/Signs" unique_id=974545069 instance=ExtResource("16_ff0o0")]
position = Vector2(1733, -1356)
direction = 1
text = "This dense forest is a StaticBody2D,
which prevents the player from walking in
between the trees even if they would fit."

