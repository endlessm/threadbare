[node name="Signs" type="Node2D" parent="OnTheGround" unique_id=540449734]
y_sort_enabled = true

[node name="Sign" parent="OnTheGround/Signs" unique_id=1956680058 instance=ExtResource("4_vilsq")]
position = Vector2(345, 651)
direction = 1
text = "Sometimes you want to decorate a large area
without placing each scene by hand."

[node name="Sign2" parent="OnTheGround/Signs" unique_id=1009085323 instance=ExtResource("4_vilsq")]
position = Vector2(587, 563)
direction = 1
text = "Threadbare uses a tool called AreaFiller,
which can automatically populate an Area2D's shapes
with scenes of your choosing."

[node name="Sign3" parent="OnTheGround/Signs" unique_id=1548001380 instance=ExtResource("4_vilsq")]
position = Vector2(963, 371)
text = "Each interaction with this rock regenerates
 the field with a new selection
of flowers and mushrooms."

[node name="Sign4" parent="OnTheGround/Signs" unique_id=1285616961 instance=ExtResource("4_vilsq")]
position = Vector2(1222, 624)
text = "Each part of this field is covered
by a CollisionPolygon2D shape,
which is a sibling of the AreaFiller node."

[node name="Sign5" parent="OnTheGround/Signs" unique_id=1444989494 instance=ExtResource("4_vilsq")]
position = Vector2(328, 60)
direction = 1
text = "For each decoration you want, add its scene to
 the \"scenes\" property of the AreaFiller."

[node name="Sign6" parent="OnTheGround/Signs" unique_id=1579530966 instance=ExtResource("4_vilsq")]
position = Vector2(799, -257)
text = "Decrease (left) or increase (right) the space
 between each object, then go back and redraw!"

[node name="Sign7" parent="OnTheGround/Signs" unique_id=613914873 instance=ExtResource("4_vilsq")]
position = Vector2(1641, -357)
text = "Use the \"sprite frames\" property to randomly
 assign each scene a sprite frames value."

