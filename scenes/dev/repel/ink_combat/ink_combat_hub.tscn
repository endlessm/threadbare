[node name="Sign" parent="OnTheGround/Signs" unique_id=254862044 instance=ExtResource("10_6674d")]
position = Vector2(766, 175)
direction = 1
text = "That wasn't so bad, right?"

[node name="Sign2" parent="OnTheGround/Signs" unique_id=392891682 instance=ExtResource("10_6674d")]
position = Vector2(167, 172)
direction = 1
text = "InkDrinkers have come from the void to consume all ink.
Encounters with them can take many forms."

[node name="Sign3" parent="OnTheGround/Signs" unique_id=383030197 instance=ExtResource("10_6674d")]
position = Vector2(293, 16)
direction = 1
text = "Here's your first task: Fill up barrels like this
one by repelling ink blobs into them!"

[node name="Sign4" parent="OnTheGround/Signs" unique_id=1212673593 instance=ExtResource("10_6674d")]
position = Vector2(1370, 177)
direction = 1
text = "Still manageable..."

[node name="Sign5" parent="OnTheGround/Signs" unique_id=1632897479 instance=ExtResource("10_6674d")]
position = Vector2(1578, 20)
direction = 1
text = "What if the wrong color of ink could
 crack the fragile barrels?"

[node name="Sign6" parent="OnTheGround/Signs" unique_id=849942120 instance=ExtResource("10_6674d")]
position = Vector2(2029, 180)
direction = 1
text = "Starting to get difficult now..."

[node name="Sign7" parent="OnTheGround/Signs" unique_id=290855963 instance=ExtResource("10_6674d")]
position = Vector2(2213, 22)
direction = 1
text = "What if you could only fill the
barrels in a specific order?"

[node name="Sign8" parent="OnTheGround/Signs" unique_id=353205667 instance=ExtResource("10_6674d")]
position = Vector2(2672, 185)
direction = 1
text = "Still looking for more?"

[node name="Sign9" parent="OnTheGround/Signs" unique_id=244874772 instance=ExtResource("10_6674d")]
position = Vector2(2903, 21)
direction = 1
text = "Think of how the previous mechanics could be combined!"

[node name="Sign10" parent="OnTheGround/Signs" unique_id=1579530966 instance=ExtResource("10_6674d")]
position = Vector2(969, 16)
direction = 1
text = "Sometimes filling the barrels invigorates the
InkDrinkers to throw with haste!"

