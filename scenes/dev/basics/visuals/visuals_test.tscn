[node name="Sign" parent="OnTheGround/Signs" unique_id=1097958739 instance=ExtResource("7_qo1v4")]
position = Vector2(282, 411)
direction = 1
text = "In the world of Threadbare, we want a consistent perspective
 where sprites are layered in a logical order."

[node name="Sign2" parent="OnTheGround/Signs" unique_id=409582822 instance=ExtResource("7_qo1v4")]
position = Vector2(530, 648)
direction = 1
text = "For example, if you walk behind this house,
it should appear in front of you!"

[node name="Sign3" parent="OnTheGround/Signs" unique_id=1916802731 instance=ExtResource("7_qo1v4")]
position = Vector2(965, 680)
direction = 1
text = "For nodes that appear \"on the ground\",
we like to group them under a Node2D
with Y Sort Enabled."

[node name="Sign4" parent="OnTheGround/Signs" unique_id=89004985 instance=ExtResource("7_qo1v4")]
position = Vector2(1253, 502)
direction = 1
text = "Otherwise you get weird visuals!
(Try walking right behind this house)"

[node name="Sign5" parent="OnTheGround/Signs" unique_id=1443631177 instance=ExtResource("7_qo1v4")]
position = Vector2(2031, 445)
direction = 1
text = "We can also create the illusion of elevated cliffs
with the elevation_2.tres and shadow.tres tilesets."

[node name="Sign6" parent="OnTheGround/Signs" unique_id=505432546 instance=ExtResource("7_qo1v4")]
position = Vector2(2592, 691)
direction = 1
text = "Don't be afraid to add more TileMapLayers!"

[node name="Sign7" parent="OnTheGround/Signs" unique_id=658399900 instance=ExtResource("7_qo1v4")]
position = Vector2(3829, 282)
text = "Be careful with the perspective of elevation.
The foam should not be visible off the back."

[node name="Sign8" parent="OnTheGround/Signs" unique_id=640159457 instance=ExtResource("7_qo1v4")]
position = Vector2(4172, 238)
direction = 1
text = "This back tile should have an alternate water tile
(no collision) to round out the corner!"

[node name="Sign9" parent="OnTheGround/Signs" unique_id=304472972 instance=ExtResource("7_qo1v4")]
position = Vector2(4200, 547)
direction = 1
text = "The alternative tiles make it possible to
walk above water and stone when using bridges."

[node name="Sign10" parent="OnTheGround/Signs" unique_id=1742773610 instance=ExtResource("7_qo1v4")]
position = Vector2(1721, 686)
text = "Head this way to see an
interactive Y-Sort example."

[node name="Sign11" parent="OnTheGround/Signs" unique_id=1579530966 instance=ExtResource("7_qo1v4")]
position = Vector2(3373, 699)
text = "Use the foam_2.tres tileset whenever
water contacts land."

[node name="Sign12" parent="OnTheGround/Signs" unique_id=1140700456 instance=ExtResource("7_qo1v4")]
position = Vector2(1685, 1259)
direction = 1
text = "Enable Y-Sorting"

[node name="Sign13" parent="OnTheGround/Signs" unique_id=291669396 instance=ExtResource("7_qo1v4")]
position = Vector2(1710, 986)
direction = 1
text = "Disable Y-Sorting"

[node name="Sign14" parent="OnTheGround/Signs" unique_id=1049138950 instance=ExtResource("7_qo1v4")]
position = Vector2(3486, 340)
direction = 1
text = "Shadows under bridges should reflect elevation.
Make sure that the start and end points
are consistent."

