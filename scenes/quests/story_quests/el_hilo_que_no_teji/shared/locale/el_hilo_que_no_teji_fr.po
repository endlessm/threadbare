msgctxt "dialogue"
msgid "Elián - El Archivero de recuerdos"
msgstr "Elián - L'Archiviste des souvenirs"

msgid "[speed=0.65]Qué frío hace... [speed=0.35]¿Manchitas? ¿Estás ahí? [next=auto]"
msgstr "[speed=0.65]Qu'est-ce qu'il fait froid... [speed=0.35]Manchitas ? Tu es là ? [next=auto]"

msgid "[speed=0.6]¿La puerta... [speed=0.7]por qué está abierta? [next=auto]"
msgstr "[speed=0.6]La porte... [speed=0.7]pourquoi est-elle ouverte ? [next=auto]"

msgid "[speed=0.45]Manchitas... si esto[speed=0.35] es un sueño... [speed=0.25]¿Por qué tengo tu collar en mis manos? [next=auto]"
msgstr "[speed=0.45]Manchitas... si c'est[speed=0.35] un rêve... [speed=0.25]pourquoi j'ai ton collier dans les mains ? [next=auto]"

msgid "[speed=0.45]Pensé que, cuando acabara mi juego… [speed=0.45] todavía te encontraría en la puerta. [next=3.0]"
msgstr "[speed=0.45]Je pensais que, quand j'aurais fini de jouer… [speed=0.45] tu serais encore à la porte. [next=3.0]"

msgid "[speed=0.45]Cuando me perdía... [speed=0.45] tú siempre sabías donde encontrarme... [next=3.0]"
msgstr "[speed=0.45]Quand je me perdais... [speed=0.45] tu savais toujours où me trouver... [next=3.0]"

msgid "[speed=0.45]Cuántos collares... [wait=0.5]y si ahora… [speed=0.45] ¿Soy yo quién llegó demasiado tarde? [next=3.0]"
msgstr "[speed=0.45]Tant de colliers... [wait=0.5]et si maintenant… [speed=0.45] c'était moi qui étais arrivé trop tard ? [next=3.0]"

msgid "[speed=0.7]¿Dónde estoy...?  [speed=0.7] ¿Qué es este sitio...?  [speed=0.7] ¿Por qué todo es tan gris...? [next=1.5]"
msgstr "[speed=0.7]Où suis-je... ?  [speed=0.7] Qu'est-ce que cet endroit... ?  [speed=0.7] Pourquoi tout est si gris... ? [next=1.5]"

msgid "[speed=0.7]Manchitas... sigue ladrando por favor... [next=3.0]"
msgstr "[speed=0.7]Manchitas... continue d'aboyer, s'il te plaît... [next=3.0]"

msgid "[speed=0.45] Te escucho… [speed=0.45] pero cada vez que quiero avanzar, el camino está destruido… [next=3.0]"
msgstr "[speed=0.45] Je t'entends… [speed=0.45] mais chaque fois que je veux avancer, le chemin est détruit… [next=3.0]"

msgid "[speed=0.45] Te sigo escuchando… [speed=0.45] pero siempre hay algo que se rompe antes de alcanzarte... [next=3.0]"
msgstr "[speed=0.45] Je t'entends encore… [speed=0.45] mais il y a toujours quelque chose qui se brise avant que je t'atteigne... [next=3.0]"

msgid "[speed=0.45]Tengo miedo de llegar... [speed=0.45] y que ya no estés ahí...[next=2.4]"
msgstr "[speed=0.45]J'ai peur d'arriver... [speed=0.45] et que tu ne sois plus là...[next=2.4]"

msgid "¡Manchitas por fin te encontré![next=1.2]"
msgstr "Manchitas, je t'ai enfin trouvé ![next=1.2]"

msgid "[speed=0.3]... [speed=0.6]No es él.[next=2.0]"
msgstr "[speed=0.3]... [speed=0.6]Ce n'est pas lui.[next=2.0]"

msgid "¿Qué?[next=1.2]"
msgstr "Quoi ?[next=1.2]"

msgid "[speed=1]El perro que buscas... No es él.[next=1.8]"
msgstr "[speed=1]Le chien que tu cherches... Ce n'est pas lui.[next=1.8]"

msgid "[speed=0.3]... [speed=0.9]Hace mucho que no veía uno de esos collares...[next=2.5]"
msgstr "[speed=0.3]... [speed=0.9]Ça fait longtemps que je n'ai pas vu un de ces colliers...[next=2.5]"

msgid "[speed=0.3]... [speed=0.9]Sabes, es una carga muy pesada para unas manos tan pequeñas.[next=2.5]"
msgstr "[speed=0.3]... [speed=0.9]Tu sais, c'est un fardeau bien lourd pour des mains si petites.[next=2.5]"

msgid "Entonces... ¿quién es?[next=1.5]"
msgstr "Alors... qui est-ce ?[next=1.5]"

msgid "[speed=0.7]Luto[speed=0.3]... [speed=0.9]o al menos lo que queda de él.[next=2.0]"
msgstr "[speed=0.7]Luto[speed=0.3]... [speed=0.9]ou du moins ce qu'il en reste.[next=2.0]"

msgid "Pensé que era mi perro Manchitas...[next=1.8]"
msgstr "Je croyais que c'était mon chien Manchitas...[next=1.8]"

msgid "También pensé eso una vez...[next=2.0]"
msgstr "Je l'ai cru moi aussi, un jour...[next=2.0]"

msgid "Entré aquí para encontrarlo...[next=1.8]"
msgstr "Je suis entré ici pour le retrouver...[next=1.8]"

msgid "Eso fue hace cuarenta años[speed=0.3]... [speed=0.9]y todavía sigo aquí.[next=2.2]"
msgstr "C'était il y a quarante ans[speed=0.3]... [speed=0.9]et je suis toujours là.[next=2.2]"

msgid "¿Y qué es lo que hay detrás de esa puerta?[next=1.5]"
msgstr "Et qu'est-ce qu'il y a derrière cette porte ?[next=1.5]"

msgid "El final de la búsqueda.[next=1.8]"
msgstr "La fin de la recherche.[next=1.8]"

msgid "No entiendo... ¿A qué te refieres?[next=1.2]"
msgstr "Je ne comprends pas... Qu'est-ce que tu veux dire ?[next=1.2]"

msgid "[speed=0.3]... [speed=0.8]El vacío que deja un amigo cuando se [wave amp=15 freq=4]va[/wave].[next=2.5]"
msgstr "[speed=0.3]... [speed=0.8]Le vide que laisse un ami quand il [wave amp=15 freq=4]part[/wave].[next=2.5]"

msgid "Niño... si vas a seguir buscando a tu perro...[next=2.0]"
msgstr "Gamin... si tu veux continuer à chercher ton chien...[next=2.0]"

msgid "[speed=0.3]... [speed=0.7]primero tienes que aceptar que ya lo has [shake rate=10 level=3]perdido[/shake].[next=3.0]"
msgstr "[speed=0.3]... [speed=0.7]il faut d'abord que tu acceptes que tu l'as déjà [shake rate=10 level=3]perdu[/shake].[next=3.0]"

msgid "[speed=0.4]A partir de ahora estoy sólo, ¿verdad? [next=auto]"
msgstr "[speed=0.4]À partir de maintenant, je suis seul, n'est-ce pas ? [next=auto]"

msgid "[speed=0.7]Ya no hay ladridos que me guíen...[next=2.0]"
msgstr "[speed=0.7]Il n'y a plus d'aboiements pour me guider...[next=2.0]"

msgid "[speed=0.5]No vayas a llegar demasiado tarde otra vez, niño...[next=3.0]"
msgstr "[speed=0.5]N'arrive pas trop tard une fois de plus, gamin...[next=3.0]"

msgid "Espera… ¿y si en lugar de devolverlo,\nlo desvío hacia el jarrón?"
msgstr "Attends… et si, au lieu de le renvoyer,\nje le dirigeais vers la jarre ?"

msgid "No puedo seguir esquivándolos…\n¿y si los desvío hacia el jarrón?"
msgstr "Je ne peux pas continuer à les esquiver…\net si je les dirigeais vers la jarre ?"

msgid "¿Y si esos proyectiles\ntuvieran que llegar al jarrón?"
msgstr "Et si ces projectiles\ndevaient arriver jusqu'à la jarre ?"

msgid "[speed=0.45]Cuando Lázaro miraba a Luto... [next=1.8]"
msgstr "[speed=0.45]Quand Lázaro regardait Luto... [next=1.8]"

msgid "[speed=0.45]Parecía que quería decirle algo... algo que ya era demasiado tarde para decir.[next=3.0]"
msgstr "[speed=0.45]On aurait dit qu'il voulait lui dire quelque chose... quelque chose qu'il était déjà trop tard pour dire.[next=3.0]"

msgid "[speed=0.45]No puedo cambiar lo que pasó esa noche...[next=2.0]"
msgstr "[speed=0.45]Je ne peux pas changer ce qui s'est passé cette nuit-là...[next=2.0]"

msgid "[speed=0.45]Pero todavía puedo hacer algo... para que esto termine diferente.[next=2.8]"
msgstr "[speed=0.45]Mais je peux encore faire quelque chose... pour que tout ça finisse autrement.[next=2.8]"

msgid "[speed=0.45]¿Tú también perdiste a alguien?[next=1.8]"
msgstr "[speed=0.45]Toi aussi, tu as perdu quelqu'un ?[next=1.8]"

msgid "[speed=0.4]Sí... Yo también llegué tarde.[next=2.2]"
msgstr "[speed=0.4]Oui... Moi aussi, je suis arrivé trop tard.[next=2.2]"

msgid "[speed=0.4]Y pasé tanto tiempo odiándome por eso... que me olvidé de extrañarla.[next=3.0]"
msgstr "[speed=0.4]Et j'ai passé tant de temps à me haïr pour ça... que j'ai oublié qu'elle me manquait.[next=3.0]"

msgid "[speed=0.4]Ese hilo que llevas en las manos, niño... [wait=0.5]es el hilo del perdón.[next=2.0]"
msgstr "[speed=0.4]Ce fil que tu tiens entre les mains, gamin... [wait=0.5]c'est le fil du pardon.[next=2.0]"

msgid "[speed=0.4]... El que yo nunca tejí.[next=3.0]"
msgstr "[speed=0.4]... Celui que je n'ai jamais tissé.[next=3.0]"

msgid "[speed=0.4]Para mí ya es demasiado tarde...[next=1.8]"
msgstr "[speed=0.4]Pour moi, il est déjà trop tard...[next=1.8]"

msgid "[speed=0.4]...tú quizás aún estés a tiempo.[next=3.5]"
msgstr "[speed=0.4]...toi, tu es peut-être encore à temps.[next=3.5]"

msgid "[speed=0.3]Lo lograste niño...[next=2.0]"
msgstr "[speed=0.3]Tu as réussi, gamin...[next=2.0]"

msgid "[speed=0.3]Llevaba tantos años aquí...[wait=1.5] y por fin puedo acariciarte.[next=2.2]"
msgstr "[speed=0.3]Ça faisait tant d'années que j'étais ici...[wait=1.5] et je peux enfin te caresser.[next=2.2]"

msgid "[speed=0.25]Perdóname, viejo amigo. Tardé demasiado en darme cuenta de que...[next=2.0]"
msgstr "[speed=0.25]Pardonne-moi, vieil ami. J'ai mis trop de temps à comprendre que...[next=2.0]"

msgid "[speed=0.25]Perdonarse no es olvidar lo que hiciste...[next=2.0]"
msgstr "[speed=0.25]Se pardonner, ce n'est pas oublier ce qu'on a fait...[next=2.0]"

msgid "[speed=0.25]... es atreverte a mirarlo sin apartar la vista, aunque nunca deje de dolerte del todo.[next=3.0]"
msgstr "[speed=0.25]... c'est oser le regarder sans détourner les yeux, même si la douleur ne s'efface jamais tout à fait.[next=3.0]"

msgid "[speed=0.25]... Todo este tiempo... eras tú el que me estaba esperando, ¿verdad, Luto?[next=2.5]"
msgstr "[speed=0.25]... Pendant tout ce temps... c'était toi qui m'attendais, n'est-ce pas, Luto ?[next=2.5]"

msgid "[speed=0.3]... [speed=0.7]Manchitas...[next=2.2]"
msgstr "[speed=0.3]... [speed=0.7]Manchitas...[next=2.2]"

msgid "[speed=0.3]... [speed=0.9]Conocí a alguien que pasó cuarenta años esperando...[next=2.8]"
msgstr "[speed=0.3]... [speed=0.9]J'ai rencontré quelqu'un qui a passé quarante ans à attendre...[next=2.8]"

msgid "[speed=0.3]... [speed=0.9]Y creo que no quiso que yo hiciera lo mismo...[next=2.8]"
msgstr "[speed=0.3]... [speed=0.9]Et je crois qu'il n'a pas voulu que je fasse pareil...[next=2.8]"

msgid "[speed=0.9]Yo tuve la suerte de encontrar una [wave amp=12 freq=3]segunda oportunidad[/wave]...[next=3.0]"
msgstr "[speed=0.9]J'ai eu la chance de trouver une [wave amp=12 freq=3]seconde chance[/wave]...[next=3.0]"

msgid "[speed=0.3]... [speed=0.7]No quiero desperdiciarla...[next=2.5]"
msgstr "[speed=0.3]... [speed=0.7]Je ne veux pas la gâcher...[next=2.5]"

msgid "[speed=0.3]... [speed=0.6]Ni hoy...[wait=1.2] [speed=0.6]ni mañana...[next=1.8]"
msgstr "[speed=0.3]... [speed=0.6]Pas aujourd'hui...[wait=1.2] [speed=0.6]pas demain...[next=1.8]"

msgid "[speed=0.3]... [speed=0.7]Ni la próxima vez que te escuche [shake rate=8 level=2]ladrar[/shake][do ladrar_despues_de_la_palabra()]...[next=3.5]"
msgstr "[speed=0.3]... [speed=0.7]Pas la prochaine fois que je t'entendrai [shake rate=8 level=2]aboyer[/shake][do ladrar_despues_de_la_palabra()]...[next=3.5]"

msgid "[speed=0.5]Yo ya perdí cuarenta años aquí...[next=1.2]"
msgstr "[speed=0.5]J'ai déjà perdu quarante ans ici...[next=1.2]"

msgid "[speed=0.5]No voy a quedarme mirando cómo pierdes los tuyos.[next=2.5]"
msgstr "[speed=0.5]Je ne vais pas rester là à te regarder perdre les tiens.[next=2.5]"

msgid "[speed=1.2]¡Guau![wait=0.25] ¡Guau![wait=0.25] ¡Guau![next=1.6]"
msgstr "[speed=1.2]Ouaf ![wait=0.25] Ouaf ![wait=0.25] Ouaf ![next=1.6]"

msgid "[speed=0.5]Luto...[wait=0.8] ya has hecho bastante por él. Ven conmigo.[next=3.0]"
msgstr "[speed=0.5]Luto...[wait=0.8] tu en as assez fait pour lui. Viens avec moi.[next=3.0]"

msgid "Luto... tú tampoco quieres que me pierda aquí, ¿verdad?"
msgstr "Luto... toi non plus, tu ne veux pas que je me perde ici, n'est-ce pas ?"

msgid "Aún no te he olvidado, Manchitas..."
msgstr "Je ne t'ai pas encore oublié, Manchitas..."

msgid "No volveré a quedarme dormido..."
msgstr "Je ne me rendormirai plus..."

msgid "Manchitas... ilumina mi camino..."
msgstr "Manchitas... éclaire mon chemin..."

msgid "Si sigo cargando con culpa ajena…\ncreo que no podré recuperarte, Manchitas..."
msgstr "Si je continue à porter la culpabilité des autres…\nje ne crois pas que je pourrai te retrouver, Manchitas..."

msgid "El final de la búsqueda... ¿será aquí?"
msgstr "La fin de la recherche... serait-ce ici ?"

msgid "¿Crees que ese perro todavía te espera?"
msgstr "Tu crois que ce chien t'attend encore ?"

msgid "Suelta ese collar, niño... Ese perro no va a volver..."
msgstr "Lâche ce collier, gamin... Ce chien ne reviendra pas..."

msgid "Si me detienes... ¿quién la va a seguir recordando?"
msgstr "Si tu m'arrêtes... qui va continuer à se souvenir d'elle ?"

msgid "Llegas tarde... como siempre...\nLos recuerdos que tienes de tu perro me pertenecen."
msgstr "Tu arrives en retard... comme toujours...\nLes souvenirs que tu as de ton chien m'appartiennent."

msgid "Intenta llenar este jarrón..."
msgstr "Essaie de remplir cette jarre..."

msgid "Tal vez lo que buscas \nesta en el lado izquierdo..."
msgstr "Peut-être que ce que tu cherches \nse trouve sur le côté gauche..."

msgid "“No todas las culpas llevan tu nombre.”"
msgstr "“Toutes les fautes ne portent pas ton nom.”"

msgid "“Pasa antes de que vuelvan.”"
msgstr "“Passe avant qu'ils reviennent.”"

msgid "“[u]Corre[/u] antes de que no quede nada.”"
msgstr "“[u]Cours[/u] avant qu'il ne reste plus rien.”"

msgid "“[u]Corre[/u]... corre y no mires atrás.”"
msgstr "“[u]Cours[/u]... cours et ne regarde pas en arrière.”"

msgid "Ira"
msgstr "Colère"
