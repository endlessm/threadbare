msgctxt "dialogue"
msgid "Elián - El Archivero de recuerdos"
msgstr "Elián - The Archivist of Memories"

msgid "[speed=0.65]Qué frío hace... [speed=0.35]¿Manchitas? ¿Estás ahí? [next=auto]"
msgstr "[speed=0.65]It's so cold... [speed=0.35]Manchitas? Are you there? [next=auto]"

msgid "[speed=0.6]¿La puerta... [speed=0.7]por qué está abierta? [next=auto]"
msgstr "[speed=0.6]The door... [speed=0.7]why is it open? [next=auto]"

msgid "[speed=0.45]Manchitas... si esto[speed=0.35] es un sueño... [speed=0.25]¿Por qué tengo tu collar en mis manos? [next=auto]"
msgstr "[speed=0.45]Manchitas... if this[speed=0.35] is a dream... [speed=0.25]why am I holding your collar? [next=auto]"

msgid "[speed=0.45]Pensé que, cuando acabara mi juego… [speed=0.45] todavía te encontraría en la puerta. [next=3.0]"
msgstr "[speed=0.45]I thought that when my game was over… [speed=0.45] you'd still be waiting at the door. [next=3.0]"

msgid "[speed=0.45]Cuando me perdía... [speed=0.45] tú siempre sabías donde encontrarme... [next=3.0]"
msgstr "[speed=0.45]Whenever I got lost... [speed=0.45] you always knew where to find me... [next=3.0]"

msgid "[speed=0.45]Cuántos collares... [wait=0.5]y si ahora… [speed=0.45] ¿Soy yo quién llegó demasiado tarde? [next=3.0]"
msgstr "[speed=0.45]So many collars... [wait=0.5]and what if now… [speed=0.45] I'm the one who got here too late? [next=3.0]"

msgid "[speed=0.7]¿Dónde estoy...?  [speed=0.7] ¿Qué es este sitio...?  [speed=0.7] ¿Por qué todo es tan gris...? [next=1.5]"
msgstr "[speed=0.7]Where am I...?  [speed=0.7] What is this place...?  [speed=0.7] Why is everything so gray...? [next=1.5]"

msgid "[speed=0.7]Manchitas... sigue ladrando por favor... [next=3.0]"
msgstr "[speed=0.7]Manchitas... keep barking, please... [next=3.0]"

msgid "[speed=0.45] Te escucho… [speed=0.45] pero cada vez que quiero avanzar, el camino está destruido… [next=3.0]"
msgstr "[speed=0.45] I hear you… [speed=0.45] but every time I try to move forward, the path is destroyed… [next=3.0]"

msgid "[speed=0.45] Te sigo escuchando… [speed=0.45] pero siempre hay algo que se rompe antes de alcanzarte... [next=3.0]"
msgstr "[speed=0.45] I can still hear you… [speed=0.45] but something always breaks before I can reach you... [next=3.0]"

msgid "[speed=0.45]Tengo miedo de llegar... [speed=0.45] y que ya no estés ahí...[next=2.4]"
msgstr "[speed=0.45]I'm afraid to get there... [speed=0.45] and find you're no longer there...[next=2.4]"

msgid "¡Manchitas por fin te encontré![next=1.2]"
msgstr "Manchitas, I finally found you![next=1.2]"

msgid "[speed=0.3]... [speed=0.6]No es él.[next=2.0]"
msgstr "[speed=0.3]... [speed=0.6]It's not him.[next=2.0]"

msgid "¿Qué?[next=1.2]"
msgstr "What?[next=1.2]"

msgid "[speed=1]El perro que buscas... No es él.[next=1.8]"
msgstr "[speed=1]The dog you're looking for... It's not him.[next=1.8]"

msgid "[speed=0.3]... [speed=0.9]Hace mucho que no veía uno de esos collares...[next=2.5]"
msgstr "[speed=0.3]... [speed=0.9]It's been a long time since I've seen one of those collars...[next=2.5]"

msgid "[speed=0.3]... [speed=0.9]Sabes, es una carga muy pesada para unas manos tan pequeñas.[next=2.5]"
msgstr "[speed=0.3]... [speed=0.9]You know, that's a heavy burden for such small hands.[next=2.5]"

msgid "Entonces... ¿quién es?[next=1.5]"
msgstr "Then... who is it?[next=1.5]"

msgid "[speed=0.7]Luto[speed=0.3]... [speed=0.9]o al menos lo que queda de él.[next=2.0]"
msgstr "[speed=0.7]Luto[speed=0.3]... [speed=0.9]or at least what's left of him.[next=2.0]"

msgid "Pensé que era mi perro Manchitas...[next=1.8]"
msgstr "I thought it was my dog Manchitas...[next=1.8]"

msgid "También pensé eso una vez...[next=2.0]"
msgstr "I thought that once too...[next=2.0]"

msgid "Entré aquí para encontrarlo...[next=1.8]"
msgstr "I came in here to find him...[next=1.8]"

msgid "Eso fue hace cuarenta años[speed=0.3]... [speed=0.9]y todavía sigo aquí.[next=2.2]"
msgstr "That was forty years ago[speed=0.3]... [speed=0.9]and I'm still here.[next=2.2]"

msgid "¿Y qué es lo que hay detrás de esa puerta?[next=1.5]"
msgstr "And what's behind that door?[next=1.5]"

msgid "El final de la búsqueda.[next=1.8]"
msgstr "The end of the search.[next=1.8]"

msgid "No entiendo... ¿A qué te refieres?[next=1.2]"
msgstr "I don't understand... What do you mean?[next=1.2]"

msgid "[speed=0.3]... [speed=0.8]El vacío que deja un amigo cuando se [wave amp=15 freq=4]va[/wave].[next=2.5]"
msgstr "[speed=0.3]... [speed=0.8]The emptiness a friend leaves behind when they [wave amp=15 freq=4]go[/wave].[next=2.5]"

msgid "Niño... si vas a seguir buscando a tu perro...[next=2.0]"
msgstr "Kid... if you're going to keep looking for your dog...[next=2.0]"

msgid "[speed=0.3]... [speed=0.7]primero tienes que aceptar que ya lo has [shake rate=10 level=3]perdido[/shake].[next=3.0]"
msgstr "[speed=0.3]... [speed=0.7]you first have to accept that you've already [shake rate=10 level=3]lost[/shake] him.[next=3.0]"

msgid "[speed=0.4]A partir de ahora estoy sólo, ¿verdad? [next=auto]"
msgstr "[speed=0.4]From now on I'm on my own, aren't I? [next=auto]"

msgid "[speed=0.7]Ya no hay ladridos que me guíen...[next=2.0]"
msgstr "[speed=0.7]There are no more barks to guide me...[next=2.0]"

msgid "[speed=0.5]No vayas a llegar demasiado tarde otra vez, niño...[next=3.0]"
msgstr "[speed=0.5]Don't get there too late again, kid...[next=3.0]"

msgid "Espera… ¿y si en lugar de devolverlo,\nlo desvío hacia el jarrón?"
msgstr "Wait… what if instead of sending it back,\nI send it into the jar?"

msgid "No puedo seguir esquivándolos…\n¿y si los desvío hacia el jarrón?"
msgstr "I can't keep dodging them…\nwhat if I send them into the jar?"

msgid "¿Y si esos proyectiles\ntuvieran que llegar al jarrón?"
msgstr "What if those projectiles\nwere meant to reach the jar?"

msgid "[speed=0.45]Cuando Lázaro miraba a Luto... [next=1.8]"
msgstr "[speed=0.45]When Lázaro looked at Luto... [next=1.8]"

msgid "[speed=0.45]Parecía que quería decirle algo... algo que ya era demasiado tarde para decir.[next=3.0]"
msgstr "[speed=0.45]It looked like he wanted to tell him something... something it was already too late to say.[next=3.0]"

msgid "[speed=0.45]No puedo cambiar lo que pasó esa noche...[next=2.0]"
msgstr "[speed=0.45]I can't change what happened that night...[next=2.0]"

msgid "[speed=0.45]Pero todavía puedo hacer algo... para que esto termine diferente.[next=2.8]"
msgstr "[speed=0.45]But I can still do something... so this ends differently.[next=2.8]"

msgid "[speed=0.45]¿Tú también perdiste a alguien?[next=1.8]"
msgstr "[speed=0.45]Did you lose someone too?[next=1.8]"

msgid "[speed=0.4]Sí... Yo también llegué tarde.[next=2.2]"
msgstr "[speed=0.4]Yes... I got there too late as well.[next=2.2]"

msgid "[speed=0.4]Y pasé tanto tiempo odiándome por eso... que me olvidé de extrañarla.[next=3.0]"
msgstr "[speed=0.4]And I spent so long hating myself for it... that I forgot to miss her.[next=3.0]"

msgid "[speed=0.4]Ese hilo que llevas en las manos, niño... [wait=0.5]es el hilo del perdón.[next=2.0]"
msgstr "[speed=0.4]That thread you're holding, kid... [wait=0.5]is the thread of forgiveness.[next=2.0]"

msgid "[speed=0.4]... El que yo nunca tejí.[next=3.0]"
msgstr "[speed=0.4]... The one I never wove.[next=3.0]"

msgid "[speed=0.4]Para mí ya es demasiado tarde...[next=1.8]"
msgstr "[speed=0.4]For me it's already too late...[next=1.8]"

msgid "[speed=0.4]...tú quizás aún estés a tiempo.[next=3.5]"
msgstr "[speed=0.4]...you might still be in time.[next=3.5]"

msgid "[speed=0.3]Lo lograste niño...[next=2.0]"
msgstr "[speed=0.3]You did it, kid...[next=2.0]"

msgid "[speed=0.3]Llevaba tantos años aquí...[wait=1.5] y por fin puedo acariciarte.[next=2.2]"
msgstr "[speed=0.3]I'd been here for so many years...[wait=1.5] and I can finally pet you.[next=2.2]"

msgid "[speed=0.25]Perdóname, viejo amigo. Tardé demasiado en darme cuenta de que...[next=2.0]"
msgstr "[speed=0.25]Forgive me, old friend. It took me too long to realize that...[next=2.0]"

msgid "[speed=0.25]Perdonarse no es olvidar lo que hiciste...[next=2.0]"
msgstr "[speed=0.25]Forgiving yourself isn't forgetting what you did...[next=2.0]"

msgid "[speed=0.25]... es atreverte a mirarlo sin apartar la vista, aunque nunca deje de dolerte del todo.[next=3.0]"
msgstr "[speed=0.25]... it's daring to look at it without turning away, even if it never stops hurting entirely.[next=3.0]"

msgid "[speed=0.25]... Todo este tiempo... eras tú el que me estaba esperando, ¿verdad, Luto?[next=2.5]"
msgstr "[speed=0.25]... All this time... you were the one waiting for me, weren't you, Luto?[next=2.5]"

msgid "[speed=0.3]... [speed=0.7]Manchitas...[next=2.2]"
msgstr "[speed=0.3]... [speed=0.7]Manchitas...[next=2.2]"

msgid "[speed=0.3]... [speed=0.9]Conocí a alguien que pasó cuarenta años esperando...[next=2.8]"
msgstr "[speed=0.3]... [speed=0.9]I met someone who spent forty years waiting...[next=2.8]"

msgid "[speed=0.3]... [speed=0.9]Y creo que no quiso que yo hiciera lo mismo...[next=2.8]"
msgstr "[speed=0.3]... [speed=0.9]And I think he didn't want me to do the same...[next=2.8]"

msgid "[speed=0.9]Yo tuve la suerte de encontrar una [wave amp=12 freq=3]segunda oportunidad[/wave]...[next=3.0]"
msgstr "[speed=0.9]I was lucky enough to find a [wave amp=12 freq=3]second chance[/wave]...[next=3.0]"

msgid "[speed=0.3]... [speed=0.7]No quiero desperdiciarla...[next=2.5]"
msgstr "[speed=0.3]... [speed=0.7]I don't want to waste it...[next=2.5]"

msgid "[speed=0.3]... [speed=0.6]Ni hoy...[wait=1.2] [speed=0.6]ni mañana...[next=1.8]"
msgstr "[speed=0.3]... [speed=0.6]Not today...[wait=1.2] [speed=0.6]not tomorrow...[next=1.8]"

msgid "[speed=0.3]... [speed=0.7]Ni la próxima vez que te escuche [shake rate=8 level=2]ladrar[/shake][do ladrar_despues_de_la_palabra()]...[next=3.5]"
msgstr "[speed=0.3]... [speed=0.7]Not the next time I hear you [shake rate=8 level=2]bark[/shake][do ladrar_despues_de_la_palabra()]...[next=3.5]"

msgid "[speed=0.5]Yo ya perdí cuarenta años aquí...[next=1.2]"
msgstr "[speed=0.5]I already lost forty years here...[next=1.2]"

msgid "[speed=0.5]No voy a quedarme mirando cómo pierdes los tuyos.[next=2.5]"
msgstr "[speed=0.5]I won't stand by and watch you lose yours.[next=2.5]"

msgid "[speed=1.2]¡Guau![wait=0.25] ¡Guau![wait=0.25] ¡Guau![next=1.6]"
msgstr "[speed=1.2]Woof![wait=0.25] Woof![wait=0.25] Woof![next=1.6]"

msgid "[speed=0.5]Luto...[wait=0.8] ya has hecho bastante por él. Ven conmigo.[next=3.0]"
msgstr "[speed=0.5]Luto...[wait=0.8] you've done enough for him. Come with me.[next=3.0]"

msgid "Luto... tú tampoco quieres que me pierda aquí, ¿verdad?"
msgstr "Luto... you don't want me to get lost here either, do you?"

msgid "Aún no te he olvidado, Manchitas..."
msgstr "I haven't forgotten you yet, Manchitas..."

msgid "No volveré a quedarme dormido..."
msgstr "I won't fall asleep again..."

msgid "Manchitas... ilumina mi camino..."
msgstr "Manchitas... light my way..."

msgid "Si sigo cargando con culpa ajena…\ncreo que no podré recuperarte, Manchitas..."
msgstr "If I keep carrying someone else's guilt…\nI don't think I'll be able to get you back, Manchitas..."

msgid "El final de la búsqueda... ¿será aquí?"
msgstr "The end of the search... could it be here?"

msgid "¿Crees que ese perro todavía te espera?"
msgstr "Do you think that dog is still waiting for you?"

msgid "Suelta ese collar, niño... Ese perro no va a volver..."
msgstr "Let go of that collar, kid... That dog isn't coming back..."

msgid "Si me detienes... ¿quién la va a seguir recordando?"
msgstr "If you stop me... who will keep remembering her?"

msgid "Llegas tarde... como siempre...\nLos recuerdos que tienes de tu perro me pertenecen."
msgstr "You're late... as always...\nThe memories you have of your dog belong to me."

msgid "Intenta llenar este jarrón..."
msgstr "Try to fill this jar..."

msgid "Tal vez lo que buscas \nesta en el lado izquierdo..."
msgstr "Maybe what you're looking for \nis on the left side..."

msgid "“No todas las culpas llevan tu nombre.”"
msgstr "“Not all guilt bears your name.”"

msgid "“Pasa antes de que vuelvan.”"
msgstr "“Get through before they come back.”"

msgid "“[u]Corre[/u] antes de que no quede nada.”"
msgstr "“[u]Run[/u] before nothing is left.”"

msgid "“[u]Corre[/u]... corre y no mires atrás.”"
msgstr "“[u]Run[/u]... run and don't look back.”"

msgid "Ira"
msgstr "Anger"
