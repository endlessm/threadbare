msgctxt "dialogue"
msgid "Elián - El Archivero de recuerdos"
msgstr "Elián - El Archivero de recuerdos"

msgid "[speed=0.65]Qué frío hace... [speed=0.35]¿Manchitas? ¿Estás ahí? [next=auto]"
msgstr "[speed=0.65]Qué frío hace... [speed=0.35]¿Manchitas? ¿Estás ahí? [next=auto]"

msgid "[speed=0.6]¿La puerta... [speed=0.7]por qué está abierta? [next=auto]"
msgstr "[speed=0.6]¿La puerta... [speed=0.7]por qué está abierta? [next=auto]"

msgid "[speed=0.45]Manchitas... si esto[speed=0.35] es un sueño... [speed=0.25]¿Por qué tengo tu collar en mis manos? [next=auto]"
msgstr "[speed=0.45]Manchitas... si esto[speed=0.35] es un sueño... [speed=0.25]¿Por qué tengo tu collar en mis manos? [next=auto]"

msgid "[speed=0.45]Pensé que, cuando acabara mi juego… [speed=0.45] todavía te encontraría en la puerta. [next=3.0]"
msgstr "[speed=0.45]Pensé que, cuando acabara mi juego… [speed=0.45] todavía te encontraría en la puerta. [next=3.0]"

msgid "[speed=0.45]Cuando me perdía... [speed=0.45] tú siempre sabías donde encontrarme... [next=3.0]"
msgstr "[speed=0.45]Cuando me perdía... [speed=0.45] tú siempre sabías donde encontrarme... [next=3.0]"

msgid "[speed=0.45]Cuántos collares... [wait=0.5]y si ahora… [speed=0.45] ¿Soy yo quién llegó demasiado tarde? [next=3.0]"
msgstr "[speed=0.45]Cuántos collares... [wait=0.5]y si ahora… [speed=0.45] ¿Soy yo quién llegó demasiado tarde? [next=3.0]"

msgid "[speed=0.7]¿Dónde estoy...?  [speed=0.7] ¿Qué es este sitio...?  [speed=0.7] ¿Por qué todo es tan gris...? [next=1.5]"
msgstr "[speed=0.7]¿Dónde estoy...?  [speed=0.7] ¿Qué es este sitio...?  [speed=0.7] ¿Por qué todo es tan gris...? [next=1.5]"

msgid "[speed=0.7]Manchitas... sigue ladrando por favor... [next=3.0]"
msgstr "[speed=0.7]Manchitas... sigue ladrando por favor... [next=3.0]"

msgid "[speed=0.45] Te escucho… [speed=0.45] pero cada vez que quiero avanzar, el camino está destruido… [next=3.0]"
msgstr "[speed=0.45] Te escucho… [speed=0.45] pero cada vez que quiero avanzar, el camino está destruido… [next=3.0]"

msgid "[speed=0.45] Te sigo escuchando… [speed=0.45] pero siempre hay algo que se rompe antes de alcanzarte... [next=3.0]"
msgstr "[speed=0.45] Te sigo escuchando… [speed=0.45] pero siempre hay algo que se rompe antes de alcanzarte... [next=3.0]"

msgid "[speed=0.45]Tengo miedo de llegar... [speed=0.45] y que ya no estés ahí...[next=2.4]"
msgstr "[speed=0.45]Tengo miedo de llegar... [speed=0.45] y que ya no estés ahí...[next=2.4]"

msgid "¡Manchitas por fin te encontré![next=1.2]"
msgstr "¡Manchitas por fin te encontré![next=1.2]"

msgid "[speed=0.3]... [speed=0.6]No es él.[next=2.0]"
msgstr "[speed=0.3]... [speed=0.6]No es él.[next=2.0]"

msgid "¿Qué?[next=1.2]"
msgstr "¿Qué?[next=1.2]"

msgid "[speed=1]El perro que buscas... No es él.[next=1.8]"
msgstr "[speed=1]El perro que buscas... No es él.[next=1.8]"

msgid "[speed=0.3]... [speed=0.9]Hace mucho que no veía uno de esos collares...[next=2.5]"
msgstr "[speed=0.3]... [speed=0.9]Hace mucho que no veía uno de esos collares...[next=2.5]"

msgid "[speed=0.3]... [speed=0.9]Sabes, es una carga muy pesada para unas manos tan pequeñas.[next=2.5]"
msgstr "[speed=0.3]... [speed=0.9]Sabes, es una carga muy pesada para unas manos tan pequeñas.[next=2.5]"

msgid "Entonces... ¿quién es?[next=1.5]"
msgstr "Entonces... ¿quién es?[next=1.5]"

msgid "[speed=0.7]Luto[speed=0.3]... [speed=0.9]o al menos lo que queda de él.[next=2.0]"
msgstr "[speed=0.7]Luto[speed=0.3]... [speed=0.9]o al menos lo que queda de él.[next=2.0]"

msgid "Pensé que era mi perro Manchitas...[next=1.8]"
msgstr "Pensé que era mi perro Manchitas...[next=1.8]"

msgid "También pensé eso una vez...[next=2.0]"
msgstr "También pensé eso una vez...[next=2.0]"

msgid "Entré aquí para encontrarlo...[next=1.8]"
msgstr "Entré aquí para encontrarlo...[next=1.8]"

msgid "Eso fue hace cuarenta años[speed=0.3]... [speed=0.9]y todavía sigo aquí.[next=2.2]"
msgstr "Eso fue hace cuarenta años[speed=0.3]... [speed=0.9]y todavía sigo aquí.[next=2.2]"

msgid "¿Y qué es lo que hay detrás de esa puerta?[next=1.5]"
msgstr "¿Y qué es lo que hay detrás de esa puerta?[next=1.5]"

msgid "El final de la búsqueda.[next=1.8]"
msgstr "El final de la búsqueda.[next=1.8]"

msgid "No entiendo... ¿A qué te refieres?[next=1.2]"
msgstr "No entiendo... ¿A qué te refieres?[next=1.2]"

msgid "[speed=0.3]... [speed=0.8]El vacío que deja un amigo cuando se [wave amp=15 freq=4]va[/wave].[next=2.5]"
msgstr "[speed=0.3]... [speed=0.8]El vacío que deja un amigo cuando se [wave amp=15 freq=4]va[/wave].[next=2.5]"

msgid "Niño... si vas a seguir buscando a tu perro...[next=2.0]"
msgstr "Niño... si vas a seguir buscando a tu perro...[next=2.0]"

msgid "[speed=0.3]... [speed=0.7]primero tienes que aceptar que ya lo has [shake rate=10 level=3]perdido[/shake].[next=3.0]"
msgstr "[speed=0.3]... [speed=0.7]primero tienes que aceptar que ya lo has [shake rate=10 level=3]perdido[/shake].[next=3.0]"

msgid "[speed=0.4]A partir de ahora estoy sólo, ¿verdad? [next=auto]"
msgstr "[speed=0.4]A partir de ahora estoy sólo, ¿verdad? [next=auto]"

msgid "[speed=0.7]Ya no hay ladridos que me guíen...[next=2.0]"
msgstr "[speed=0.7]Ya no hay ladridos que me guíen...[next=2.0]"

msgid "[speed=0.5]No vayas a llegar demasiado tarde otra vez, niño...[next=3.0]"
msgstr "[speed=0.5]No vayas a llegar demasiado tarde otra vez, niño...[next=3.0]"

msgid "Espera… ¿y si en lugar de devolverlo,\nlo desvío hacia el jarrón?"
msgstr "Espera… ¿y si en lugar de devolverlo,\nlo desvío hacia el jarrón?"

msgid "No puedo seguir esquivándolos…\n¿y si los desvío hacia el jarrón?"
msgstr "No puedo seguir esquivándolos…\n¿y si los desvío hacia el jarrón?"

msgid "¿Y si esos proyectiles\ntuvieran que llegar al jarrón?"
msgstr "¿Y si esos proyectiles\ntuvieran que llegar al jarrón?"

msgid "[speed=0.45]Cuando Lázaro miraba a Luto... [next=1.8]"
msgstr "[speed=0.45]Cuando Lázaro miraba a Luto... [next=1.8]"

msgid "[speed=0.45]Parecía que quería decirle algo... algo que ya era demasiado tarde para decir.[next=3.0]"
msgstr "[speed=0.45]Parecía que quería decirle algo... algo que ya era demasiado tarde para decir.[next=3.0]"

msgid "[speed=0.45]No puedo cambiar lo que pasó esa noche...[next=2.0]"
msgstr "[speed=0.45]No puedo cambiar lo que pasó esa noche...[next=2.0]"

msgid "[speed=0.45]Pero todavía puedo hacer algo... para que esto termine diferente.[next=2.8]"
msgstr "[speed=0.45]Pero todavía puedo hacer algo... para que esto termine diferente.[next=2.8]"

msgid "[speed=0.45]¿Tú también perdiste a alguien?[next=1.8]"
msgstr "[speed=0.45]¿Tú también perdiste a alguien?[next=1.8]"

msgid "[speed=0.4]Sí... Yo también llegué tarde.[next=2.2]"
msgstr "[speed=0.4]Sí... Yo también llegué tarde.[next=2.2]"

msgid "[speed=0.4]Y pasé tanto tiempo odiándome por eso... que me olvidé de extrañarla.[next=3.0]"
msgstr "[speed=0.4]Y pasé tanto tiempo odiándome por eso... que me olvidé de extrañarla.[next=3.0]"

msgid "[speed=0.4]Ese hilo que llevas en las manos, niño... [wait=0.5]es el hilo del perdón.[next=2.0]"
msgstr "[speed=0.4]Ese hilo que llevas en las manos, niño... [wait=0.5]es el hilo del perdón.[next=2.0]"

msgid "[speed=0.4]... El que yo nunca tejí.[next=3.0]"
msgstr "[speed=0.4]... El que yo nunca tejí.[next=3.0]"

msgid "[speed=0.4]Para mí ya es demasiado tarde...[next=1.8]"
msgstr "[speed=0.4]Para mí ya es demasiado tarde...[next=1.8]"

msgid "[speed=0.4]...tú quizás aún estés a tiempo.[next=3.5]"
msgstr "[speed=0.4]...tú quizás aún estés a tiempo.[next=3.5]"

msgid "[speed=0.3]Lo lograste niño...[next=2.0]"
msgstr "[speed=0.3]Lo lograste niño...[next=2.0]"

msgid "[speed=0.3]Llevaba tantos años aquí...[wait=1.5] y por fin puedo acariciarte.[next=2.2]"
msgstr "[speed=0.3]Llevaba tantos años aquí...[wait=1.5] y por fin puedo acariciarte.[next=2.2]"

msgid "[speed=0.25]Perdóname, viejo amigo. Tardé demasiado en darme cuenta de que...[next=2.0]"
msgstr "[speed=0.25]Perdóname, viejo amigo. Tardé demasiado en darme cuenta de que...[next=2.0]"

msgid "[speed=0.25]Perdonarse no es olvidar lo que hiciste...[next=2.0]"
msgstr "[speed=0.25]Perdonarse no es olvidar lo que hiciste...[next=2.0]"

msgid "[speed=0.25]... es atreverte a mirarlo sin apartar la vista, aunque nunca deje de dolerte del todo.[next=3.0]"
msgstr "[speed=0.25]... es atreverte a mirarlo sin apartar la vista, aunque nunca deje de dolerte del todo.[next=3.0]"

msgid "[speed=0.25]... Todo este tiempo... eras tú el que me estaba esperando, ¿verdad, Luto?[next=2.5]"
msgstr "[speed=0.25]... Todo este tiempo... eras tú el que me estaba esperando, ¿verdad, Luto?[next=2.5]"

msgid "[speed=0.3]... [speed=0.7]Manchitas...[next=2.2]"
msgstr "[speed=0.3]... [speed=0.7]Manchitas...[next=2.2]"

msgid "[speed=0.3]... [speed=0.9]Conocí a alguien que pasó cuarenta años esperando...[next=2.8]"
msgstr "[speed=0.3]... [speed=0.9]Conocí a alguien que pasó cuarenta años esperando...[next=2.8]"

msgid "[speed=0.3]... [speed=0.9]Y creo que no quiso que yo hiciera lo mismo...[next=2.8]"
msgstr "[speed=0.3]... [speed=0.9]Y creo que no quiso que yo hiciera lo mismo...[next=2.8]"

msgid "[speed=0.9]Yo tuve la suerte de encontrar una [wave amp=12 freq=3]segunda oportunidad[/wave]...[next=3.0]"
msgstr "[speed=0.9]Yo tuve la suerte de encontrar una [wave amp=12 freq=3]segunda oportunidad[/wave]...[next=3.0]"

msgid "[speed=0.3]... [speed=0.7]No quiero desperdiciarla...[next=2.5]"
msgstr "[speed=0.3]... [speed=0.7]No quiero desperdiciarla...[next=2.5]"

msgid "[speed=0.3]... [speed=0.6]Ni hoy...[wait=1.2] [speed=0.6]ni mañana...[next=1.8]"
msgstr "[speed=0.3]... [speed=0.6]Ni hoy...[wait=1.2] [speed=0.6]ni mañana...[next=1.8]"

msgid "[speed=0.3]... [speed=0.7]Ni la próxima vez que te escuche [shake rate=8 level=2]ladrar[/shake][do ladrar_despues_de_la_palabra()]...[next=3.5]"
msgstr "[speed=0.3]... [speed=0.7]Ni la próxima vez que te escuche [shake rate=8 level=2]ladrar[/shake][do ladrar_despues_de_la_palabra()]...[next=3.5]"

msgid "[speed=0.5]Yo ya perdí cuarenta años aquí...[next=1.2]"
msgstr "[speed=0.5]Yo ya perdí cuarenta años aquí...[next=1.2]"

msgid "[speed=0.5]No voy a quedarme mirando cómo pierdes los tuyos.[next=2.5]"
msgstr "[speed=0.5]No voy a quedarme mirando cómo pierdes los tuyos.[next=2.5]"

msgid "[speed=1.2]¡Guau![wait=0.25] ¡Guau![wait=0.25] ¡Guau![next=1.6]"
msgstr "[speed=1.2]¡Guau![wait=0.25] ¡Guau![wait=0.25] ¡Guau![next=1.6]"

msgid "[speed=0.5]Luto...[wait=0.8] ya has hecho bastante por él. Ven conmigo.[next=3.0]"
msgstr "[speed=0.5]Luto...[wait=0.8] ya has hecho bastante por él. Ven conmigo.[next=3.0]"

msgid "Luto... tú tampoco quieres que me pierda aquí, ¿verdad?"
msgstr "Luto... tú tampoco quieres que me pierda aquí, ¿verdad?"

msgid "Aún no te he olvidado, Manchitas..."
msgstr "Aún no te he olvidado, Manchitas..."

msgid "No volveré a quedarme dormido..."
msgstr "No volveré a quedarme dormido..."

msgid "Manchitas... ilumina mi camino..."
msgstr "Manchitas... ilumina mi camino..."

msgid "Si sigo cargando con culpa ajena…\ncreo que no podré recuperarte, Manchitas..."
msgstr "Si sigo cargando con culpa ajena…\ncreo que no podré recuperarte, Manchitas..."

msgid "El final de la búsqueda... ¿será aquí?"
msgstr "El final de la búsqueda... ¿será aquí?"

msgid "¿Crees que ese perro todavía te espera?"
msgstr "¿Crees que ese perro todavía te espera?"

msgid "Suelta ese collar, niño... Ese perro no va a volver..."
msgstr "Suelta ese collar, niño... Ese perro no va a volver..."

msgid "Si me detienes... ¿quién la va a seguir recordando?"
msgstr "Si me detienes... ¿quién la va a seguir recordando?"

msgid "Llegas tarde... como siempre...\nLos recuerdos que tienes de tu perro me pertenecen."
msgstr "Llegas tarde... como siempre...\nLos recuerdos que tienes de tu perro me pertenecen."

msgid "Intenta llenar este jarrón..."
msgstr "Intenta llenar este jarrón..."

msgid "Tal vez lo que buscas \nesta en el lado izquierdo..."
msgstr "Tal vez lo que buscas \nesta en el lado izquierdo..."

msgid "“No todas las culpas llevan tu nombre.”"
msgstr "“No todas las culpas llevan tu nombre.”"

msgid "“Pasa antes de que vuelvan.”"
msgstr "“Pasa antes de que vuelvan.”"

msgid "“[u]Corre[/u] antes de que no quede nada.”"
msgstr "“[u]Corre[/u] antes de que no quede nada.”"

msgid "“[u]Corre[/u]... corre y no mires atrás.”"
msgstr "“[u]Corre[/u]... corre y no mires atrás.”"

msgid "Ira"
msgstr "Ira"
