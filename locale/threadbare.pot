msgid "Notice the tile map is built with multiple layers. This makes it easier to make changes to the environment."
msgstr ""

#: scenes/quests/template_quests/NO_EDIT/1_NO_EDIT_stealth/NO_EDIT_stealth_components/NO_EDIT_stealth.dialogue:5
