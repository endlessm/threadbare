#. TRANSLATORS: Character name
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue
msgctxt "dialogue"
msgid "StoryQuest Elder"
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:3
msgid "[[Hi|Hello|Greetings]], StoryWeaver. We've been waiting for you. Our world is unraveling!"
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:4
msgid "We need you to recover the Sacred Elements: the threads of Memory, Imagination, and Spirit! Will you help us?"
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:8
msgid "Please stay. Our world will perish without your help!"
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:9
msgid "I hope to see you again. We really need you!"
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:10
msgid "The people of Threadbare are counting on you. I hope you change your mind!"
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:14
msgid "You have rescued Apollo before… and thanks to you he returned safe and sound."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:15
msgid "But that boy always finds new mischief… he may need your guidance once more."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:16
msgid "If you wish to return to the forest, you can relive the quest and refine your path."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:19
msgid "You have already faced the memory-devouring forest… few ever return from it."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:20
msgid "If you wish to go back, the forest trails will be ready to test you once again."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:23
msgid "Stella continues to look to the sky with hope thanks to you."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:24
msgid "If you accompany her again, you will be able to experience the story from a different light."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:27
msgid "Your support restored Nora’s confidence when she needed it most."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:28
msgid "But knowledge always brings new trials to those who return."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:29
msgid "If you choose to try again, you’ll be able to master every step of the challenge."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:31
msgid "You have walked this story before… yet tales shift with every return."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:32
msgid "If you wish to relive it, the thread of this adventure will open itself to you once more."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:34
msgid "We believe in you, StoryWeaver. Become the hero, and see where the path leads."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#. Character: Template Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:37
#: scenes/game_elements/characters/npcs/elder/components/template_quest_starter.dialogue:14
msgid "Go on, StoryWeaver: take the threads to the Eternal Loom."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#. Character: Template Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:40
#: scenes/game_elements/characters/npcs/elder/components/template_quest_starter.dialogue:17
msgid "Thank you, StoryWeaver! The fabric of the world slowly heals!"
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#. Character: Template Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:41
#: scenes/game_elements/characters/npcs/elder/components/template_quest_starter.dialogue:18
msgid "Go forth: our world still needs your help."
msgstr ""

#. TRANSLATORS: Character: StoryQuest Elder
#. Character: Template Elder
#: scenes/game_elements/characters/npcs/elder/components/story_quest_starter.dialogue:44
#: scenes/game_elements/characters/npcs/elder/components/template_quest_starter.dialogue:21
msgid "I don't have any quests for you. Talk to my fellow Elders."
msgstr ""

#. TRANSLATORS: Character name
#: scenes/game_elements/characters/npcs/elder/components/template_quest_starter.dialogue
msgctxt "dialogue"
msgid "Template Elder"
msgstr ""

#. TRANSLATORS: Character: Template Elder
#: scenes/game_elements/characters/npcs/elder/components/template_quest_starter.dialogue:3
msgid "[[Hi|Hello|Greetings]]! We've been waiting for you. Our world is full of stories!"
msgstr ""

#. TRANSLATORS: Character: Template Elder
#: scenes/game_elements/characters/npcs/elder/components/template_quest_starter.dialogue:4
msgid "We have some StoryQuest templates for you to explore. These stories are yours to adapt and make your own!"
msgstr ""

#. TRANSLATORS: Character: Template Elder
#: scenes/game_elements/characters/npcs/elder/components/template_quest_starter.dialogue:8
msgid "No rush! Take your time and feel free to check back whenever you're ready."
msgstr ""

#. TRANSLATORS: Character: Template Elder
#: scenes/game_elements/characters/npcs/elder/components/template_quest_starter.dialogue:9
msgid "Whenever you're curious, come back and take a look at the templates!"
msgstr ""

#. TRANSLATORS: Character: Template Elder
#: scenes/game_elements/characters/npcs/elder/components/template_quest_starter.dialogue:11
msgid "Explore the template, adapt the story, and see where the path leads."
msgstr ""

#: scenes/game_elements/characters/npcs/elder/story_quest_elder.tscn
