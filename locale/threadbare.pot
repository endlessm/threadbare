#: scenes/quests/template_quests/NO_EDIT/0_NO_EDIT_intro/NO_EDIT_intro_components/NO_EDIT_intro.dialogue:6
msgid "Welcome to the StoryQuest template, where you'll learn how to mod elements of each scene and create your own StoryQuest! Let's start with the intro."
msgstr ""

#: scenes/quests/template_quests/NO_EDIT/0_NO_EDIT_intro/NO_EDIT_intro_components/NO_EDIT_intro.dialogue:7
msgid "In the Godot FileSystem, find the intro folder and double-click on the intro dialogue file to edit the text."
msgstr ""

#: scenes/quests/template_quests/NO_EDIT/0_NO_EDIT_intro/NO_EDIT_intro_components/NO_EDIT_intro.dialogue:8
msgid "Press enter to add a new line. Each line becomes a new dialogue box in-game."
msgstr ""

#: scenes/quests/template_quests/NO_EDIT/0_NO_EDIT_intro/NO_EDIT_intro_components/NO_EDIT_intro.dialogue:9
msgid "Select Cinematic node; drag your StoryQuest dialogue to the \"Dialogue\" field in the Inspector."
msgstr ""

#: scenes/quests/template_quests/NO_EDIT/0_NO_EDIT_intro/NO_EDIT_intro_components/NO_EDIT_intro.dialogue:10
msgid "Set the next scene using the \"Next Scene\" field in the Inspector."
msgstr ""

#: scenes/quests/template_quests/NO_EDIT/0_NO_EDIT_intro/NO_EDIT_intro_components/NO_EDIT_intro.dialogue:12
msgid "Explore other elements to mod, like the placeholder image, tile map, and animation options for this scene!"
